# ============================================================================
# POOSSER Auth API — variables d'environnement
# Copier ce fichier en .env et renseigner de vraies valeurs. Ne JAMAIS committer
# le fichier .env réel (voir .gitignore).
# ============================================================================

NODE_ENV=development
PORT=4000

# ---- Base de données -------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/poosser_auth
DATABASE_SSL=false

# ---- Secrets JWT (générer avec: openssl rand -base64 48) -------------------
# Un secret distinct par type de token = défense en profondeur (un secret qui
# fuite ne compromet qu'un seul type de jeton).
JWT_ACCESS_SECRET=changeme-access-secret-min-32-chars
JWT_ACCESS_TTL_SECONDS=900

JWT_OTP_TICKET_SECRET=changeme-otp-ticket-secret-min-32-chars
OTP_TICKET_TTL_SECONDS=600

JWT_STEPUP_SECRET=changeme-stepup-secret-min-32-chars
JWT_STEPUP_TTL_SECONDS=300

REFRESH_TOKEN_TTL_SECONDS=2592000

# ---- Hachage Argon2id pour PIN / OTP (secrets courts, voir docs/ARCHITECTURE.md §5)
ARGON2_PIN_MEMORY_KB=65536
ARGON2_PIN_TIME_COST=3
ARGON2_PIN_PARALLELISM=1

# ---- OTP ---------------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ---- Fournisseur SMS ------------------------------------------------------
# "console" : OTP journalisé côté serveur (dev uniquement), aucun SMS réel envoyé.
# "africastalking" / "twilio" : nécessitent les clés ci-dessous.
SMS_PROVIDER=console

AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ---- Rate limiting (toutes les limites sont configurables, jamais codées en dur)
RATE_LIMIT_OTP_REQUEST_PER_PHONE=3
RATE_LIMIT_OTP_REQUEST_PER_PHONE_WINDOW_SECONDS=900
RATE_LIMIT_OTP_REQUEST_PER_IP=10
RATE_LIMIT_OTP_REQUEST_PER_IP_WINDOW_SECONDS=3600
RATE_LIMIT_OTP_RESEND_COOLDOWN_SECONDS=60

RATE_LIMIT_OTP_VERIFY_PER_PHONE=10
RATE_LIMIT_OTP_VERIFY_PER_PHONE_WINDOW_SECONDS=900

RATE_LIMIT_LOGIN_PER_PHONE=5
RATE_LIMIT_LOGIN_PER_PHONE_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_PER_IP=20
RATE_LIMIT_LOGIN_PER_IP_WINDOW_SECONDS=900
ACCOUNT_LOCK_DURATION_SECONDS=900

RATE_LIMIT_RECOVERY_PER_PHONE=3
RATE_LIMIT_RECOVERY_PER_PHONE_WINDOW_SECONDS=86400

RATE_LIMIT_CHANGE_PIN_PER_USER=5
RATE_LIMIT_CHANGE_PIN_PER_USER_WINDOW_SECONDS=3600

# ---- Divers -----------------------------------------------------------
DEFAULT_PHONE_COUNTRY=CM
DEFAULT_LOCALE=fr
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
